  {
    "field_name": "Profile Parameter Values",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Parameters_SmokeBaselineExtend",
    "value": "{\"protocol\": {\"smoke\": \"tcp,udp\", \"baseline\": \"tcp,udp\", \"extended\": \"tcp,udp\", \"notes\": \"Sweep/list value. Command column documents it; omit this flag so yaml expands cases.\"}, \"port\": {\"smoke\": \"5201\", \"baseline\": \"5201\", \"extended\": \"5201\", \"notes\": \"\"}, \"reverse_mode\": {\"smoke\": \"false\", \"baseline\": \"false\", \"extended\": \"false\", \"notes\": \"\"}, \"window_size\": {\"smoke\": \"256K\", \"baseline\": \"256K\", \"extended\": \"256K\", \"notes\": \"\"}, \"buffer_length\": {\"smoke\": \"128K\", \"baseline\": \"128K\", \"extended\": \"128K\", \"notes\": \"\"}, \"parallel_streams\": {\"smoke\": \"1\", \"baseline\": \"1\", \"extended\": \"1\", \"notes\": \"\"}, \"bandwidth_limit\": {\"smoke\": \"0\", \"baseline\": \"0\", \"extended\": \"0\", \"notes\": \"2026-10-19 metric review: bandwidth_limit 10G -> 0 (iperf3 unlimited). With the 10G cap, udp_throughput_gbps reported the cap (9.99 Gbit/s on every profile on MI300X hosts, while TCP loopback reached 55 Gbit/s). Packet loss is now measured at the unlimited send rate, so expect it to be higher than with the cap.\"}, \"omit_initial_seconds\": {\"smoke\": \"0\", \"baseline\": \"1\", \"extended\": \"1\", \"notes\": \"\"}, \"interval\": {\"smoke\": \"1\", \"baseline\": \"1\", \"extended\": \"1\", \"notes\": \"\"}, \"time\": {\"smoke\": \"2\", \"baseline\": \"100\", \"extended\": \"290\", \"notes\": \"VM 2026-08-16 time=210 -> 211s (3:31); UDP is near-instant on loopback so TCP dominates. Extended 590 extrapolated ~9:52, not tested. Retimed 2026-08-17 toward 3-4 min baseline; extended scaled by the same factor.\"}}"
